# pnpm 配置
# ------------------------------------------------------------------
# 注意：这里刻意不使用 pnpm-workspace.yaml。
# 该文件只要存在，pnpm 就会按「workspace 定义」解析它；缺少 packages 字段时，
# 连 `pnpm store path` 这种基础命令都会报 “packages field missing or empty”，
# 导致 GitHub Actions 的 setup-node 缓存步骤直接失败。
#
# 允许 esbuild 执行安装脚本（它需要下载对应平台的二进制）：
# 写在 .npmrc 里不会被误认为 workspace 定义。
# pnpm 9/10/11 都接受这个键名。
only-built-dependencies[]=esbuild

# 演示项目对安装脚本没有额外需求，保持严格模式即可
strict-peer-dependencies=false
